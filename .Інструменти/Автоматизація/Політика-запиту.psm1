function New-AILangScheduledPrompt {
    param([string]$Prompt,[guid]$SessionId,[ValidateSet('manual','automatic')][string]$Mode)
    $policy = if ($Mode -eq 'automatic') {
        'Увімкнена погоджена автоматизація. Перед кожним запитом дозволу оціни необхідність, межі доручення, оборотність і ризик. Сумісні запити подавай штатному auto-review. Не схвалюй себе сам і не обходь відмову. Дії поза погодженим завданням, секрети, непогоджені руйнівні дії, тести та вимкнення ПК залишаються забороненими. Невизначене або відхилене відклади до рішення автора.'
    } else {
        'Автор за ПК. Запити дозволів передавай автору для ручного схвалення; не вмикай автоматичний review самостійно.'
    }
    $journal = '.Інструменти/Автоматизація/Записати-рішення.ps1'
    return @"
$Prompt

[Режим автоматизації AILang: $Mode; цільовий сеанс: $SessionId]
$policy
Веди локальний журнал рішень через $journal. До запиту запиши RequestId, SessionId $SessionId, Mode $Mode, Decision assessed, Source agent, Action (несекретний опис дії), Reason (обґрунтування). Після фактичного рішення запиши той самий RequestId з Decision approved або denied і Source user або auto_review відповідно до реального джерела. Окремо фіксуй executed/failed з Source agent. Не вигадуй підтвердження; якщо платформа не надає рішення, запиши невідоме в Reason оцінки та зупини залежну дію. Якщо журнал недоступний, не продовжуй автономну дію. Не записуй токени, паролі, приватний вивід або секретні аргументи. Таймер і прийняття queue не є схваленням окремих дій.
Перечитай поточні налаштування, доручення й фактичні ліміти. Цей запит не скасовує зупинку автора та не додає інших дозволів.
"@
}
Export-ModuleMember -Function New-AILangScheduledPrompt
